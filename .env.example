# Storage
STORAGE_ROOT=./data/files
DB_PATH=./data/db
UPLOAD_TEMP_DIR=./data/tmp
THUMBNAIL_DIR=./data/thumbnails
# 0 means no extra logical quota; real filesystem availability still applies.
STORAGE_QUOTA_BYTES=0
# Bytes ordinary writes must leave available on the filesystem.
STORAGE_RESERVED_BYTES=1073741824
# 0 derives the temporary-space limit from quota/filesystem capacity.
STORAGE_TEMP_LIMIT_BYTES=0

# Uploads
MAX_FILE_SIZE=5368709120
UPLOAD_CHUNK_SIZE=10485760
UPLOAD_TIMEOUT=3600
# Maximum number of Files accepted by one directory prepare request.
DIRECTORY_UPLOAD_MAX_ENTRIES=10000
# Maximum number of path segments, including the File name.
DIRECTORY_UPLOAD_MAX_DEPTH=32
# Maximum UTF-8 byte length of one relative path.
DIRECTORY_UPLOAD_MAX_PATH_BYTES=1024
# Maximum number of root + descendant nodes in one recursive Folder Copy.
FOLDER_COPY_MAX_NODES=10000
# Maximum number of root + descendant nodes in one Folder ZIP download.
FOLDER_ZIP_MAX_NODES=10000
# Maximum total uncompressed File bytes in one Folder ZIP download (20 GiB).
FOLDER_ZIP_MAX_UNCOMPRESSED_BYTES=21474836480

# File Version history (created on replace/save/restore)
FILE_VERSIONING_ENABLED=true
FILE_VERSION_MAX_COUNT=20
FILE_VERSION_RETENTION_DAYS=90

# WebDAV
# Disabled by default. Set WEBDAV_ENABLED=true to expose the fixed /dav endpoint.
WEBDAV_ENABLED=false

# Pipeline
PIPELINE_WORKERS=4
PIPELINE_SKIP_LARGE=1073741824
# 文档切片大小：中文建议 500；英文长文可按需调高到 800-1200
PIPELINE_CHUNK_SIZE=500
# 相邻切片重叠字符数：中文建议 100，通常为 chunk size 的 15%-25%
PIPELINE_CHUNK_OVERLAP=100
# Embedding 批大小：默认 20，兼容 DeepSeek/OpenAI 兼容接口与本地 Ollama
PIPELINE_EMBED_BATCH_SIZE=20
# Parent/Child 双层切片：child 用于向量召回，parent 用于 RAG 上下文
PIPELINE_PARENT_CHUNK_SIZE=1024
PIPELINE_CHILD_CHUNK_SIZE=256

# Media OCR
# 图片 OCR 默认开启；若环境未安装 tesseract，会自动降级为只提取缩略图/元信息
OCR_ENABLED=true
OCR_BIN=tesseract
OCR_LANGS=eng+chi_sim
OCR_TIMEOUT_SECONDS=60
OCR_MIN_TEXT_RUNES=8
OCR_MAX_IMAGE_BYTES=20971520

# Media Transcribe
# 音频/视频转录默认关闭；默认 mode=whisper-cpp，需要自行挂载 whisper.cpp 模型文件
# 若代理支持 OpenAI Whisper，可切换 TRANSCRIBE_MODE=openai 并配置 TRANSCRIBE_API_*。
TRANSCRIBE_ENABLED=false
TRANSCRIBE_MODE=whisper-cpp
TRANSCRIBE_BIN=whisper-cli
TRANSCRIBE_MODEL_PATH=/models/ggml-base.en.bin
TRANSCRIBE_API_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_MODEL=whisper-1
TRANSCRIBE_LANG=auto
TRANSCRIBE_TIMEOUT_SECONDS=600
TRANSCRIBE_MAX_BYTES=209715200

# Video Text Extraction
# 视频会尝试抽音轨转录，并每隔 N 秒抽一帧做 OCR；转录仍受 TRANSCRIBE_ENABLED 控制
VIDEO_OCR_ENABLED=true
VIDEO_FRAME_INTERVAL_SECONDS=30
VIDEO_FRAME_LIMIT=60
VIDEO_AUDIO_ENABLED=true

# Janitor
# 启动恢复与周期清理：恢复中断 Pipeline、失败化卡住任务、清理孤儿缩略图
JANITOR_ENABLED=true
JANITOR_INTERVAL_SECONDS=600
JANITOR_RECOVER_ON_BOOT=true
JANITOR_MAX_TASK_AGE_SECONDS=1800
# 谨慎开启：会把 storage 中未登记到 DB 的文件移入 STORAGE_ROOT/.trash，不会直接删除
JANITOR_SWEEP_STORAGE_ENABLED=false

# 回收站 / Trash
TRASH_AUTO_PURGE=true
TRASH_RETENTION_DAYS=30

# RAG
# RAG 检索默认返回的上下文片段数
RAG_TOP_K=5
# 语义搜索默认返回的片段数
RAG_SEARCH_TOP_K=10
# RAG Prompt 中允许拼接的最大上下文字数，避免超出模型上下文窗口
RAG_MAX_CONTEXT_CHARS=6000
# 最小相似度阈值，0 表示不过滤；cosine distance 会转换为 score = 1 - distance
RAG_MIN_SCORE=0
# 多轮对话检索前用 LLM 将指代问题改写为独立 query
RAG_QUERY_CONDENSE=true
# 可选：预留单独的 condense model 名称，当前 provider 默认复用聊天模型
RAG_CONDENSE_MODEL=
# 按分数百分位动态裁剪低分结果；0 表示关闭
RAG_SCORE_PERCENTILE=0.25
# 为短/模糊 query 生成多个等价检索 query 后合并
RAG_MULTI_QUERY=true
RAG_MULTI_QUERY_COUNT=3
# SQLite chunk 全文检索 + Chroma 向量检索，使用 RRF 融合
RAG_HYBRID_SEARCH=true
RAG_RRF_K=60
# 自然语言意图搜索：从“今天的 pdf / 三个月前上传的 xlsx”等查询里提取日期和文件类型
RAG_INTENT_PARSE=true
# 规则无法识别但像过滤意图时，允许用 LLM 兜底解析结构化条件
RAG_INTENT_LLM_FALLBACK=true
RAG_INTENT_TIMEZONE=Asia/Shanghai
# 语义搜索预过滤 file_id 数量上限，避免 SQL IN 过大
RAG_INTENT_FILE_LIMIT=500

# LLM
# 设置 OPENAI_API_KEY 后优先使用 OpenAI 兼容接口，未设置则自动降级到本地 Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
# 自定义 OpenAI 兼容 API 地址 (DeepSeek/Claude/硅基流动等)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
CHROMA_BASE_URL=http://chroma:8000

# Security
# development keeps local setup easy; production enables strict startup gates.
APP_ENV=development
ADMIN_PASSWORD=
JWT_SECRET=change-me-in-production
TOKEN_TTL_SECONDS=604800
# Only permits an empty ADMIN_PASSWORD in production when explicitly true.
TRUSTED_NETWORK_ONLY=false
# Declares that a production reverse proxy terminates HTTPS. This does not enable TLS in Go.
EDGE_HTTPS_ENABLED=false
# Comma-separated CIDRs. X-Forwarded-For is ignored unless the direct peer matches one.
TRUSTED_PROXY_CIDRS=

# Browser CORS. Empty means same-origin only; development defaults to the two Vite :5173 origins.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Fixed-window API limits.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_FAILURES=5
RATE_LIMIT_READ_REQUESTS=600
RATE_LIMIT_WRITE_REQUESTS=120
RATE_LIMIT_UPLOAD_REQUESTS=600
RATE_LIMIT_AI_REQUESTS=30

# Frontend API
# In production with TLS reverse proxy, use your HTTPS domain.
# Example: https://drive.example.com/api
VITE_API_BASE_URL=/api

# TLS reverse proxy (docker-compose.prod.yml)
# Map host cert files into edge nginx container.
TLS_CERT_PATH=./deploy/certs/fullchain.pem
TLS_CERT_KEY_PATH=./deploy/certs/privkey.pem
